# Copy this file to .art.env and fill in values for your Artifactory replica.
# .art.env is git-ignored; never commit live credentials.
APH_LIVE_ARTIFACTORY_ROOT=https://artifactory.example.com/artifactory/generic-repo/hub
APH_LIVE_ARTIFACTORY_CONFIG_FILE=__CONFIG__/hub-config.yml
APH_LIVE_PROFILE_ID=example-profile
APH_LIVE_HUB_ID=live-artifactory-replica
APH_LIVE_CLI_EXPECTED_FILE=skills/example-skill/SKILL.md
APH_LIVE_VSCODE_EXPECTED_FILE=.copilot/skills/example-skill/SKILL.md
APH_LIVE_ARTIFACTORY_CREDENTIAL_REF=ARTIFACTORY_READER_TOKEN
APH_LIVE_SOURCE_SYNC_WAIT_MS=5000
APH_LIVE_OBSERVE_MS=15000
# Leave empty to be prompted securely at launch, or set for an unattended run.
ARTIFACTORY_READER_TOKEN=
# Set APH_LIVE_ARTIFACTORY_AUTH=anonymous for a publicly readable hub.
# APH_LIVE_ARTIFACTORY_AUTH=bearer
