{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://github.com/AmadeusITGroup/ai-primitives-hub/schemas/lockfile.schema.json",
  "title": "AI Primitives Hub install record",
  "description": "Schema for ai-primitives-hub.lock.json and ai-primitives-hub.local.lock.json (format 3.0.0). Bundles are keyed by bundle id, then by tool (harness). Unknown fields are allowed and kept by readers.",
  "type": "object",
  "required": [
    "$schema",
    "version",
    "level",
    "generatedAt",
    "generatedBy",
    "bundles",
    "sources"
  ],
  "additionalProperties": true,
  "properties": {
    "$schema": {
      "type": "string",
      "description": "JSON schema reference for validation",
      "examples": [
        "https://github.com/AmadeusITGroup/ai-primitives-hub/schemas/lockfile.schema.json"
      ]
    },
    "version": {
      "type": "string",
      "description": "Record format version; readers stop on a major version above 3",
      "pattern": "^3\\.(0|[1-9]\\d*)\\.(0|[1-9]\\d*)$",
      "examples": [
        "3.0.0"
      ]
    },
    "level": {
      "type": "string",
      "description": "Level this record belongs to",
      "enum": [
        "repository",
        "user"
      ]
    },
    "generatedAt": {
      "type": "string",
      "description": "ISO 8601 timestamp of the last write",
      "format": "date-time"
    },
    "generatedBy": {
      "type": "string",
      "description": "Writer and version, e.g. ai-primitives-hub-cli@0.3.0 or ai-primitives-hub-extension@1.0.0",
      "minLength": 1
    },
    "bundles": {
      "type": "object",
      "description": "Map of bundle IDs to their tool entries",
      "additionalProperties": {
        "$ref": "#/definitions/bundle"
      }
    },
    "sources": {
      "type": "object",
      "description": "Map of source IDs to their configuration (unchanged from 2.0.0)",
      "additionalProperties": {
        "$ref": "#/definitions/source"
      }
    },
    "hubs": {
      "type": "object",
      "description": "Map of hub IDs, named by a source's hubId, to the hub's import reference; never holds credentials",
      "additionalProperties": {
        "$ref": "#/definitions/hub"
      }
    },
    "profiles": {
      "type": "object",
      "description": "Profile configuration, carried through unchanged"
    }
  },
  "definitions": {
    "name": {
      "type": "string",
      "description": "Tool or source type name; readers keep names they do not know",
      "pattern": "^[a-z][a-z0-9-]*$"
    },
    "bundle": {
      "type": "object",
      "description": "All tool entries for one bundle",
      "required": [
        "tools"
      ],
      "additionalProperties": true,
      "properties": {
        "tools": {
          "type": "object",
          "description": "Map of tool names (target types) to entries",
          "minProperties": 1,
          "propertyNames": {
            "$ref": "#/definitions/name"
          },
          "additionalProperties": {
            "$ref": "#/definitions/entry"
          }
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "description": "Collection, manifest or index id of the bundle, without a version"
        }
      }
    },
    "entry": {
      "type": "object",
      "description": "What one tool has installed for one bundle",
      "required": [
        "version",
        "sourceId",
        "sourceType",
        "installedAt",
        "files"
      ],
      "additionalProperties": true,
      "properties": {
        "version": {
          "type": "string",
          "minLength": 1
        },
        "sourceId": {
          "type": "string",
          "minLength": 1
        },
        "sourceType": {
          "$ref": "#/definitions/name"
        },
        "installedAt": {
          "type": "string",
          "format": "date-time"
        },
        "needsReinstall": {
          "const": true,
          "description": "Present only under the tool name 'unknown'"
        },
        "files": {
          "type": "array",
          "description": "Files this entry owns, sorted by path",
          "items": {
            "$ref": "#/definitions/file"
          }
        },
        "installationId": {
          "type": "string",
          "description": "Stable id of this install",
          "pattern": "^inst-[0-9a-f]{8,64}$"
        },
        "integrity": {
          "type": "string",
          "description": "sha256: of the downloaded bundle content: each bundle path with its file's sha256, sorted",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "root": {
          "type": "string",
          "minLength": 1,
          "description": "Folder the tool writes to when it is not the level root, '~'-relative; file paths are relative to it"
        },
        "plugins": {
          "type": "array",
          "description": "Agent Plugins the entry installed; their files are also in files",
          "items": {
            "$ref": "#/definitions/plugin"
          }
        },
        "mcpServers": {
          "type": "array",
          "description": "MCP servers the entry owns; their definitions stay in the tool's MCP file",
          "items": {
            "$ref": "#/definitions/mcpServer"
          }
        }
      }
    },
    "file": {
      "type": "object",
      "description": "One file an entry wrote",
      "required": [
        "path",
        "checksum"
      ],
      "additionalProperties": true,
      "properties": {
        "path": {
          "type": "string",
          "description": "Path relative to the level root; forward slashes; no leading '/', drive letter or '..' segment",
          "pattern": "^(?![/\\\\])(?![A-Za-z]:)(?!(?:.*[/\\\\])?\\.\\.(?:[/\\\\]|$)).+$",
          "examples": [
            ".github/prompts/my-prompt.prompt.md",
            ".kiro/steering/style.md"
          ]
        },
        "checksum": {
          "type": "string",
          "description": "sha256: followed by the lowercase hex SHA-256 of the bytes on disk",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "sourcePath": {
          "type": "string",
          "minLength": 1,
          "description": "Path of the file inside the bundle"
        },
        "mode": {
          "type": "string",
          "description": "File mode, only when not the default",
          "pattern": "^0[0-7]{3}$"
        }
      }
    },
    "source": {
      "type": "object",
      "description": "Source configuration entry",
      "required": [
        "type",
        "url"
      ],
      "additionalProperties": true,
      "properties": {
        "type": {
          "type": "string",
          "minLength": 1
        },
        "url": {
          "type": "string",
          "minLength": 1
        },
        "branch": {
          "type": "string"
        },
        "collectionsPath": {
          "type": "string"
        },
        "indexFile": {
          "type": "string"
        },
        "authMode": {
          "type": "string"
        },
        "credentialRef": {
          "type": "string",
          "minLength": 1
        },
        "hubId": {
          "type": "string",
          "description": "Key in hubs of the shared hub the source came from",
          "minLength": 1
        }
      }
    },
    "hub": {
      "type": "object",
      "description": "A shared hub's import reference; entries carried over by migration may have other fields",
      "additionalProperties": true,
      "properties": {
        "name": {
          "type": "string"
        },
        "type": {
          "type": "string",
          "minLength": 1
        },
        "location": {
          "type": "string",
          "minLength": 1
        },
        "ref": {
          "type": "string"
        },
        "configFile": {
          "type": "string"
        }
      }
    },
    "plugin": {
      "type": "object",
      "description": "One Agent Plugin (a plugin.json folder)",
      "required": [
        "name",
        "root"
      ],
      "additionalProperties": true,
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "version": {
          "type": "string"
        },
        "manifestDigest": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "root": {
          "type": "string",
          "minLength": 1
        },
        "skills": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "mcpServers": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "mcpServer": {
      "type": "object",
      "description": "One MCP server the entry owns; ${env:VAR} stays unresolved and no secret is stored",
      "required": [
        "config",
        "name"
      ],
      "additionalProperties": true,
      "properties": {
        "config": {
          "type": "string",
          "minLength": 1,
          "description": "The tool's MCP file, relative to the level root"
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "item": {
          "type": "string"
        },
        "checksum": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        }
      }
    }
  }
}
