{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://raw.githubusercontent.com/AmadeusITGroup/ai-primitives-hub/main/packages/core/src/public/schemas/lockfile.schema.json",
  "title": "AI Primitives Hub Lockfile (v3)",
  "description": "Multi-target, records-only lockfile (version 3.0.0): installation records and the sources they were acquired from. Payload snapshots and harness selection are kept outside the lockfile. The single-target v2 format is described by lockfile-v2.schema.json.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "$schema",
    "version",
    "generatedAt",
    "generatedBy",
    "sources",
    "bundles"
  ],
  "properties": {
    "$schema": {
      "type": "string",
      "minLength": 1
    },
    "version": {
      "const": "3.0.0"
    },
    "generatedAt": {
      "type": "string",
      "format": "date-time"
    },
    "generatedBy": {
      "type": "string",
      "minLength": 1
    },
    "sources": {
      "type": "object",
      "propertyNames": {
        "$ref": "#/definitions/v3Id"
      },
      "additionalProperties": {
        "$ref": "#/definitions/v3Source"
      }
    },
    "bundles": {
      "type": "object",
      "propertyNames": {
        "pattern": "^bundle-[a-f0-9]{24}$"
      },
      "additionalProperties": {
        "$ref": "#/definitions/v3Bundle"
      }
    }
  },
  "definitions": {
    "v3Id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512,
      "pattern": "^(?!\\.\\.?$)(?!\\.\\.)[^/\\\\\\u0000<>:\"|?*]+$"
    },
    "v3TargetType": {
      "enum": [
        "vscode",
        "vscode-insiders",
        "copilot-cli",
        "kiro",
        "kiro-cli",
        "windsurf",
        "claude-code",
        "cursor",
        "opencode",
        "devin",
        "devin-cli"
      ]
    },
    "v3RelativePath": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4096,
      "pattern": "^(?!/)(?![A-Za-z]:)(?!\\.\\.?$)(?!.*(?:^|/)\\.\\.(?:/|$))[^\\\\\\u0000]+$",
      "description": "Forward-slash relative file path; normalization and strict root containment are also enforced at runtime."
    },
    "v3Root": {
      "type": "string",
      "minLength": 1,
      "maxLength": 8192,
      "description": "Canonical absolute path on this execution host, checked using its native filesystem adapter."
    },
    "v3Mode": {
      "type": "integer",
      "minimum": 0,
      "maximum": 511
    },
    "v3File": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "checksum"
      ],
      "properties": {
        "path": {
          "$ref": "#/definitions/v3RelativePath"
        },
        "checksum": {
          "type": "string",
          "pattern": "^sha256:[a-f0-9]{64}$"
        },
        "mode": {
          "$ref": "#/definitions/v3Mode"
        },
        "sourcePath": {
          "$ref": "#/definitions/v3RelativePath"
        }
      }
    },
    "v3Instance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "scope",
        "root",
        "version",
        "installationId",
        "payloadId",
        "installedAt",
        "files"
      ],
      "properties": {
        "scope": {
          "enum": [
            "user",
            "repository"
          ]
        },
        "root": {
          "type": "string",
          "minLength": 1,
          "description": "Absolute for user scope; relative to the repository (e.g. \".kiro\") for repository scope."
        },
        "version": {
          "type": "string",
          "minLength": 1
        },
        "installationId": {
          "type": "string",
          "pattern": "^rcpt-[a-f0-9]{24}$",
          "description": "Opaque installation identity."
        },
        "payloadId": {
          "$ref": "#/definitions/v3Id",
          "description": "Content address of the payload snapshot kept under the user data directory."
        },
        "installedAt": {
          "type": "string",
          "format": "date-time"
        },
        "files": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/v3File"
          }
        }
      }
    },
    "v3Bundle": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "sourceId",
        "manifestId",
        "bundleId",
        "tools"
      ],
      "properties": {
        "sourceId": {
          "$ref": "#/definitions/v3Id"
        },
        "manifestId": {
          "$ref": "#/definitions/v3Id"
        },
        "bundleId": {
          "$ref": "#/definitions/v3Id"
        },
        "tools": {
          "type": "object",
          "propertyNames": {
            "$ref": "#/definitions/v3TargetType"
          },
          "additionalProperties": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "instances"
            ],
            "properties": {
              "instances": {
                "type": "object",
                "propertyNames": {
                  "pattern": "^inst-[a-f0-9]{24}$"
                },
                "additionalProperties": {
                  "$ref": "#/definitions/v3Instance"
                }
              }
            }
          }
        }
      }
    },
    "v3Source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "url"
      ],
      "properties": {
        "type": {
          "type": "string",
          "minLength": 1
        },
        "url": {
          "type": "string",
          "description": "Where the collection can be re-acquired; empty when unknown."
        }
      }
    }
  }
}
